# 敏感配置（真实 token 不入库）
config/.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 测试生成物
tests/sample/out/

# 源论文 PDF 与解析产物不入库（版权/体积；README 提供 arXiv 链接）
input/

# 过程文件与临时文件不入库（output/work 保留占位 .gitkeep）
work/*
!work/.gitkeep
_output/
temp/
_parts/
_validate_out*.txt
luatex-cache/

# 编译中间物默认忽略；四态成品例外（output/example 展示用）
*.pdf
*.tex
*.aux
*.log
*.out
*.toc
!output/*_bilingual.pdf
!output/*_single.pdf
!output/*_bilingual.md
!output/*_zh.md
!example/*_bilingual.pdf
# doc/ 下的对外分发成品例外（用户明确要求入库供下载）
!doc/*.pdf
!example/*_single.pdf
!example/*_bilingual.md
!example/*_zh.md
